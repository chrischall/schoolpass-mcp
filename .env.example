# SchoolPass parent account credentials.
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# NOTE: SchoolPass fronts its login form with reCAPTCHA. Repeated failed logins
# can get an account challenged, so a typo here costs more than a retry —
# double-check before the first run.
SCHOOLPASS_EMAIL=you@example.com
SCHOOLPASS_PASSWORD=

# The numeric school id SchoolPass uses to select your school (the "AppCode" /
# `appCode` value). Find it by signing into your school's school-pass.net portal,
# opening the new SchoolPass app, and reading `appCode` from localStorage — it is
# also the `AppCode` header on the app's API requests. Example: 1183 (Scholars
# Academy). It is not a secret, just a tenant selector.
SCHOOLPASS_SCHOOL_CODE=

# Optional. Regional API host override. Each school lives on one regional shard;
# the default serves the US East 16 region. If your school is elsewhere, set the
# host the app talks to (the `apiUrl` in the same localStorage).
# SCHOOLPASS_API_HOST=busapi-east16-ss.school-pass.net

# Optional: the session is cached between runs so a restart does not
# re-authenticate. Set to false to turn that off.
# SCHOOLPASS_SESSION_CACHE=false
# Optional: where that cache lives. Defaults to $MCP_DATA_DIR/.schoolpass-mcp/session.json.
# SCHOOLPASS_SESSION_FILE=/path/to/cache.json
